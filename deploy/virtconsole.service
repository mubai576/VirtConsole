[Unit]
Description=VirtConsole HDMI Terminal Application
Requires=virtconsole-weston.service
After=virtconsole-weston.service

[Service]
User=virtconsole
Group=virtconsole
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/virtconsole
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -S /run/virtconsole/wayland-0 ] && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/local/bin/virtconsole-host
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
