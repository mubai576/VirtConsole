[Unit]
Description=VirtConsole Weston Kiosk (Wayland compositor on HDMI)
Wants=systemd-user-sessions.service
After=systemd-user-sessions.service
Conflicts=getty@tty1.service

[Service]
User=virtconsole
Group=virtconsole
SupplementaryGroups=video render input tty
Environment=XDG_RUNTIME_DIR=/run/virtconsole
RuntimeDirectory=virtconsole
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/weston --backend=drm-backend.so --shell=kiosk-shell.so --socket=wayland-0
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
