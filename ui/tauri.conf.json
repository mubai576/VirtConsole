{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VirtConsole",
  "version": "0.1.0",
  "identifier": "com.virtconsole.app",
  "build": {
    "frontendDist": "../ui/frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VirtConsole",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
